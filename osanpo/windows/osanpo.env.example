# Copy this file to osanpo.env and edit. osanpo.env is ignored by git.
# Use only letters, digits and - _ for the token (cmd.exe mangles other characters).
OSANPO_TOKEN=change-me-to-a-long-random-string
OSANPO_PORT=5072

# StackChan gateway (stackchan-mcp). Fill in when you reach that step.
# STACKCHAN_TOKEN=another-long-random-string
# VISION_HOST=192.168.0.10
